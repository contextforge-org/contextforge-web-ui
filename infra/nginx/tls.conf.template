# Rendered by the stock nginx:alpine image's docker-entrypoint envsubst
# step at /etc/nginx/templates/default.conf.template -> /etc/nginx/conf.d/
# default.conf. Only variables actually set in the container's environment
# are substituted, so nginx's own $host/$scheme/etc. are left untouched.
#
# HTTPS: terminates TLS and proxies to the app over plain HTTP.
server {
    listen 443 ssl;
    server_name _;

    ssl_certificate /certs/cert.pem;
    ssl_certificate_key /certs/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://app:3000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Keeps the :8443 port; $host would drop it.
        proxy_set_header X-Forwarded-Host $http_host;
        # Overwrites (not $proxy_add_x_forwarded_for) — TRUST_PROXY=true is
        # only safe behind a proxy that overwrites this header, never one
        # that appends to a client-supplied value.
        proxy_set_header X-Forwarded-For $remote_addr;

        # SSE: no buffering, HTTP/1.1 upstream, long read timeout.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # No Strict-Transport-Security — this is a self-signed localhost cert;
    # HSTS would pin developers' browsers to HTTPS for `localhost` itself.
}

# HTTP: same proxying, unless NGINX_FORCE_HTTPS=true redirects to HTTPS
# first. :8443 is hardcoded — it's the published host port, which doesn't
# change with the container's internal listen port.
server {
    listen 80;
    server_name _;

    set $force_https "${NGINX_FORCE_HTTPS}";
    if ($force_https = "true") {
        return 301 https://$host:8443$request_uri;
    }

    location / {
        proxy_pass http://app:3000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
