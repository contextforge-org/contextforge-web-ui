# Env for docker-compose.yml's `app` service. Copy to `.env`:
#   cp .env.docker.example .env
#
# Distinct from server/.env.example, which is for running the BFF natively
# (outside Docker) during local development.

# --- Works out of the box (dev-friendly compose defaults) ---

# REQUIRED to be false here (or set PUBLIC_ORIGIN/TRUST_PROXY below) for
# compose to boot with zero other config — see server/src/config.ts's two
# fail-closed startup checks. Set to "true" for any real deployment, and
# then also set PUBLIC_ORIGIN (or TRUST_PROXY=true).
COOKIE_SECURE=false

# Intentionally left UNSET. This compose file also starts a `redis`
# service, but the app does NOT use it by default — it falls back to
# config.ts's own default (REDIS_URL=memory://: in-process, lost on
# restart, single-instance only). Uncomment to opt into the real Redis
# service this compose file provides:
# REDIS_URL=redis://redis:6379/0

# --- Must be set for this to be useful (no safe default) ---

# Upstream ContextForge/mcpgateway FastAPI instance. The code's own default
# (http://127.0.0.1:4444) is the container's OWN loopback and will not be
# reachable — point this at wherever your gateway actually runs (a host
# address, another service on a shared Docker network, a staging URL, ...).
# There is no boot-time check for this: leaving it wrong lets the app boot
# "successfully" while every /api/* call fails at request time. See
# DOCKER.md's troubleshooting section.
FASTAPI_URL=

# --- Fine as-is for dev; revisit for production ---
PORT=3000
HOST=0.0.0.0
FASTAPI_AUTH_HEADER_NAME=Authorization
SESSION_TTL_SECONDS=86400
REDIS_KEY_PREFIX=bff
COOKIE_DOMAIN=
TRUST_PROXY=false
PUBLIC_ORIGIN=
SSE_SESSION_RECHECK_SECONDS=15
LOG_LEVEL=info

# --- Production checklist (uncomment/set when deploying for real) ---
# COOKIE_SECURE=true
# REDIS_URL=redis://redis:6379/0   # or your managed Redis
# PUBLIC_ORIGIN=https://your-domain.example.com
# # (or, if directly TLS-terminated with no reverse proxy in front: TRUST_PROXY=true)
