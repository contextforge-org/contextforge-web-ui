###############################################################
# Mend Unified-Agent configuration file
# contextforge-web-ui (Node / TypeScript project)
###############################################################

###########
# General #
###########
# First scan: OVERRIDE to establish the baseline.
# Subsequent scans: change to APPEND so previous results are preserved.
projectName=contextforge-web-ui
updateType=APPEND
#log.level=debug

###########################################################################################
# Includes/Excludes Glob patterns - Please use only one exclude line and one include line #
###########################################################################################
includes=package.json package-lock.json **/package.json **/package-lock.json

excludes=**/node_modules/** **/e2e/** **/test/** **/*.test.* **/*.spec.* **/dist/** **/build/** **/.next/**